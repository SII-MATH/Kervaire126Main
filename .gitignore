.lake/
__pycache__/
*.pyc
.DS_Store

# Historical reviews, sessions, reports and migration records are local archives.
/local-history/

# Lean outputs from standalone review probes; keep the .lean sources.
*.olean
*.olean.private
*.olean.server
*.ilean
*.ir

# LaTeX intermediates; published PDFs and audit logs remain versionable.
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.xdv

# Reproducible Blueprint/Lean graph and static site. Native authored node/edge
# attachments in subdirectories remain versionable; only derived files ignored.
/blueprint/generated/
/hgraph/nodes/*.md
/hgraph/edges/*.md
/_site/
/._site-*/

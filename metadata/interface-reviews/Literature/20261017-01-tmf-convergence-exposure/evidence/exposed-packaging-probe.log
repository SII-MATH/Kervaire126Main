@[expose] def KIP126.Literature.ExposedPackagingProbe.directAtomicProof : (n : Nat) → { m // m = n } :=
fun n =>
  have hn := ⋯;
  ⟨n, hn⟩
@[expose] def KIP126.Literature.ExposedPackagingProbe.directAtomicTrans : (n : Nat) → { m // m = n } :=
fun n =>
  have hn := ⋯;
  have ht := ⋯;
  ⟨n, ht⟩
@[expose] def KIP126.Literature.ExposedPackagingProbe.nestedByProof : (n : Nat) → { m // m = n } :=
fun n => ⟨n, ⋯⟩
@[expose] def KIP126.Literature.ExposedPackagingProbe.privateViaBy : (n : Nat) → { m // m = n } :=
fun n => ⟨n, ⋯⟩
@[expose] def KIP126.Literature.ExposedPackagingProbe.compositeTerm : (n : Nat) → { m // m = n } :=
fun n => ⟨n, ⋯⟩

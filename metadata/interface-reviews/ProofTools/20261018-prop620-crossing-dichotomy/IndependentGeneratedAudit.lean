import all KIP126.SpectralSequence.PageComparison.Data
import all KIP126.SpectralSequence.PageComparison.Predicates
import all KIP126.SpectralSequence.PageComparison.Raw.Data
import all KIP126.SpectralSequence.PageComparison.Raw.Proofs
import all KIP126.SpectralSequence.PageLevel.Data
import all KIP126.SpectralSequence.PageLevel.Proofs
import all KIP126.SpectralSequence.Permanence.Predicates
import all KIP126.SpectralSequence.Permanence.Proofs
import all KIP126.SpectralSequence.Representatives.Proofs
import all KIP126.SpectralSequence.Transport
import all KIP126.SpectralSequence.Truncation.Data
import all KIP126.SpectralSequence.Truncation.Predicates
import all KIP126.SpectralSequence.Truncation.Proofs
import all KIP126.SpectralSequence.Truncation
import all KIP126.SpectralSequence.UnboundedExtension.TruncatedComplex.Data
import all KIP126.SpectralSequence.UnboundedExtension.TruncatedComplex.Proofs
import all KIP126.SpectralSequence.UnboundedExtension.TruncatedSpectralSequence.Data
import all KIP126.SpectralSequence
import Lean

open Lean Elab Command in
set_option maxHeartbeats 0 in
run_cmd do
  let env ← getEnv
  let registryText ← liftIO <| IO.FS.readFile "metadata/proof-obligations.json"
  let .ok registry := Json.parse registryText | throwError "Invalid obligation registry"
  let .ok obligations := registry.getObjValAs? (Array Json) "obligations" | throwError "Missing registry obligations"
  let mut registered : Array String := #[]
  for item in obligations do
    let .ok name := item.getObjValAs? String "name" | throwError "Registry item missing name"
    registered := registered.push name
  for root in #[`KIP126.ProofTools.Paper.FiniteExtensionNonliftableShortTo._proof_2,
      `KIP126.ProofTools.Paper.FiniteExtensionNonliftableShortTo._proof_3,
      `KIP126.AdamsSynthetic.towerGradedIso.eq_1,
      `KIP126.Kervaire.Route.extensionSourceObject.eq_1] do
    let some rootInfo := env.find? root | throwError "Missing root {root}"
    logInfo m!"KERNEL_TYPE {root}: {rootInfo.type}"
    let mut pending := #[root]
    let mut seen : NameSet := {}
    let mut project : Array String := #[]
    let mut holes : Array String := #[]
    let mut localHoles : Array String := #[]
    let mut main : Array String := #[]
    let mut projectAxioms : Array String := #[]
    while !pending.isEmpty do
      let name := pending.back!
      pending := pending.pop
      if seen.contains name then continue
      seen := seen.insert name
      let userName := (privateToUserName? name).getD name
      unless userName.toString.startsWith "KIP126." do continue
      let some info := env.find? name | throwError "Missing dependency {name}"
      project := project.push userName.toString
      let body := info.value? (allowOpaque := true)
      if info.type.hasSorry || body.any (·.hasSorry) then
        holes := holes.push userName.toString
        if userName.toString.startsWith "KIP126.ProofTools." then
          localHoles := localHoles.push userName.toString
      if userName.toString.startsWith "KIP126.Main." then
        main := main.push userName.toString
      if let .axiomInfo _ := info then
        projectAxioms := projectAxioms.push userName.toString
      pending := pending ++ info.type.getUsedConstants
      if let some value := body then pending := pending ++ value.getUsedConstants
    let axioms ← collectAxioms root
    logInfo m!"AUDIT_JSON {(Json.mkObj [
      ("root", toJson root.toString),
      ("level_params", toJson (rootInfo.levelParams.map Name.toString)),
      ("project_constant_count", toJson project.size),
      ("direct_sorry_dependencies", toJson holes),
      ("direct_sorry_count", toJson holes.size),
      ("proof_tools_sorry_dependencies", toJson localHoles),
      ("main_dependencies", toJson main),
      ("unregistered_direct_holes", toJson (holes.filter fun n => !registered.contains n)),
      ("project_axioms", toJson projectAxioms),
      ("axioms", toJson (axioms.map Name.toString))]).pretty}"

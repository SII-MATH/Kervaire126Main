theorem KIP126.ProofTools.Paper.finiteExtension_descends : ∀ (X Y : KIP126.Kervaire.Route.ClassicalObject)
  (f :
    KIP126.Kervaire.Route.ClassicalObject.obj KIP126.AdamsSynthetic.Standard.model.auxiliary X ⟶
      KIP126.Kervaire.Route.ClassicalObject.obj KIP126.AdamsSynthetic.Standard.model.auxiliary Y)
  (rEarlier rLater : ℕ) (n s t : ℤ) (x : ↑(KIP126.ProofTools.Ambient KIP126.AdamsSynthetic.Standard.model X (s, t)))
  (y : ↑(KIP126.ProofTools.Ambient KIP126.AdamsSynthetic.Standard.model Y (s + n, t + n))),
  2 ≤ rEarlier →
    rEarlier ≤ rLater →
      n ≤
          ↑rEarlier - 2 +
            ↑(KIP126.AdamsSynthetic.normalizedExponent KIP126.AdamsSynthetic.Standard.model.classicalTower f) →
        KIP126.Kervaire.Route.FiniteExtension KIP126.AdamsSynthetic.Standard.model X Y f rLater n s t x y →
          KIP126.Kervaire.Route.FiniteExtension KIP126.AdamsSynthetic.Standard.model X Y f rEarlier n s t x y :=
fun X Y f rEarlier rLater n s t x y hr hle hnUpper h =>
  Nonempty.casesOn h fun W =>
    let ra :=
      (KIP126.AdamsSynthetic.Standard.model.quotients.tower
            (KIP126.Kervaire.Route.SyntheticObject.obj KIP126.AdamsSynthetic.Standard.model.nu
              KIP126.AdamsSynthetic.Standard.model.auxiliary
              (KIP126.Kervaire.Route.extensionSourceObject KIP126.AdamsSynthetic.Standard.model X Y f))).rho
        (rEarlier - 1) (rLater - 1) (Nat.sub_le_sub_right hle 1);
    let rb :=
      (KIP126.AdamsSynthetic.Standard.model.quotients.tower
            (KIP126.AdamsSynthetic.Standard.model.nu.functor.obj
              (KIP126.Kervaire.Route.ClassicalObject.obj KIP126.AdamsSynthetic.Standard.model.auxiliary Y))).rho
        (rEarlier - 1) (rLater - 1) (Nat.sub_le_sub_right hle 1);
    Nonempty.intro
      { page_ge_two := hr, length_lower := W.length_lower, length_upper := hnUpper,
        source_cycle :=
          KIP126.Core.SpectralSequence.FinitePageCalculus.reaches_earlier
            (Decidable.byContradiction fun a =>
              KIP126.ProofTools.Paper.finiteExtension_descends._proof_1_1 X Y f rEarlier rLater n hr a)
            (Decidable.byContradiction fun a =>
              KIP126.ProofTools.Paper.finiteExtension_descends._proof_1_2 X Y f rEarlier rLater n hle a)
            W.source_cycle,
        target_cycle :=
          KIP126.Core.SpectralSequence.FinitePageCalculus.reaches_earlier
            (Decidable.byContradiction fun a =>
              KIP126.ProofTools.Paper.finiteExtension_descends._proof_1_3 X Y f rEarlier rLater n hnUpper a)
            (Decidable.byContradiction fun a =>
              KIP126.ProofTools.Paper.finiteExtension_descends._proof_1_4 X Y f rEarlier rLater n hle a)
            W.target_cycle,
        source :=
          (CategoryTheory.ConcreteCategory.hom
              (KIP126.Core.SpectralSequence.SpectralSequenceMorphism.eInftyMap
                (KIP126.AdamsSynthetic.Standard.model.family.functor.map ra)
                (s, t - s + s,
                  t +
                    ↑(KIP126.AdamsSynthetic.normalizedExponent KIP126.AdamsSynthetic.Standard.model.classicalTower f))))
            W.source,
        target :=
          (CategoryTheory.ConcreteCategory.hom
              (KIP126.Core.SpectralSequence.SpectralSequenceMorphism.eInftyMap
                (KIP126.AdamsSynthetic.Standard.model.family.functor.map rb)
                (s + n, t - s + (s + n),
                  t +
                    ↑(KIP126.AdamsSynthetic.normalizedExponent KIP126.AdamsSynthetic.Standard.model.classicalTower f))))
            W.target,
        source_rep :=
          have hh :=
            KIP126.ProofTools.Internal.family_infinity_representative_map ra
              (s, t - s + s,
                t + ↑(KIP126.AdamsSynthetic.normalizedExponent KIP126.AdamsSynthetic.Standard.model.classicalTower f))
              (KIP126.Kervaire.Route.finiteSourceForExtension KIP126.AdamsSynthetic.Standard.model X Y f (rLater - 1) s
                t x)
              W.source W.source_rep;
          Eq.mp
            (congrArg
              (fun _a =>
                KIP126.AdamsSynthetic.HasInfinityRepresentative
                  (KIP126.AdamsSynthetic.Standard.model.family.obj
                    (KIP126.Synthetic.Context.XModLambdaN
                      (KIP126.Kervaire.Route.SyntheticObject.obj KIP126.AdamsSynthetic.Standard.model.nu
                        KIP126.AdamsSynthetic.Standard.model.auxiliary
                        (KIP126.Kervaire.Route.extensionSourceObject KIP126.AdamsSynthetic.Standard.model X Y f))
                      (rEarlier - 1)))
                  2
                  (s, t - s + s,
                    t +
                      ↑(KIP126.AdamsSynthetic.normalizedExponent KIP126.AdamsSynthetic.Standard.model.classicalTower f))
                  _a
                  ((CategoryTheory.ConcreteCategory.hom
                      (KIP126.Core.SpectralSequence.SpectralSequenceMorphism.eInftyMap
                        (KIP126.AdamsSynthetic.Standard.model.family.map ra)
                        (s, t - s + s,
                          t +
                            ↑(KIP126.AdamsSynthetic.normalizedExponent
                                KIP126.AdamsSynthetic.Standard.model.classicalTower f))))
                    W.source))
              (KIP126.ProofTools.Internal.finite_source_rho X Y f (rEarlier - 1) (rLater - 1)
                (Nat.sub_le_sub_right hle 1) s t x))
            hh,
        target_rep :=
          have hh :=
            KIP126.ProofTools.Internal.family_infinity_representative_map rb
              (s + n, t - s + (s + n),
                t + ↑(KIP126.AdamsSynthetic.normalizedExponent KIP126.AdamsSynthetic.Standard.model.classicalTower f))
              (KIP126.Kervaire.Route.finiteTargetForExtension KIP126.AdamsSynthetic.Standard.model X Y f (rLater - 1) n
                s t W.length_lower y)
              W.target W.target_rep;
          Eq.mp
            (congrArg
              (fun _a =>
                KIP126.AdamsSynthetic.HasInfinityRepresentative
                  (KIP126.AdamsSynthetic.Standard.model.family.obj
                    (KIP126.Synthetic.Context.XModLambdaN
                      (KIP126.AdamsSynthetic.Standard.model.nu.functor.obj
                        (KIP126.Kervaire.Route.ClassicalObject.obj KIP126.AdamsSynthetic.Standard.model.auxiliary Y))
                      (rEarlier - 1)))
                  2
                  (s + n, t - s + (s + n),
                    t +
                      ↑(KIP126.AdamsSynthetic.normalizedExponent KIP126.AdamsSynthetic.Standard.model.classicalTower f))
                  _a
                  ((CategoryTheory.ConcreteCategory.hom
                      (KIP126.Core.SpectralSequence.SpectralSequenceMorphism.eInftyMap
                        (KIP126.AdamsSynthetic.Standard.model.family.map rb)
                        (s + n, t - s + (s + n),
                          t +
                            ↑(KIP126.AdamsSynthetic.normalizedExponent
                                KIP126.AdamsSynthetic.Standard.model.classicalTower f))))
                    W.target))
              (KIP126.ProofTools.Internal.finite_target_rho X Y f (rEarlier - 1) (rLater - 1)
                (Nat.sub_le_sub_right hle 1) n s t W.length_lower y))
            hh,
        equation :=
          KIP126.ProofTools.Paper.extension_square_map
            (KIP126.Kervaire.Route.SyntheticObject.quotient (rLater - 1)
              (KIP126.Kervaire.Route.extensionSourceObject KIP126.AdamsSynthetic.Standard.model X Y f))
            (KIP126.Kervaire.Route.SyntheticObject.quotient (rLater - 1) (KIP126.Kervaire.Route.SyntheticObject.nu Y))
            (KIP126.Kervaire.Route.SyntheticObject.quotient (rEarlier - 1)
              (KIP126.Kervaire.Route.extensionSourceObject KIP126.AdamsSynthetic.Standard.model X Y f))
            (KIP126.Kervaire.Route.SyntheticObject.quotient (rEarlier - 1) (KIP126.Kervaire.Route.SyntheticObject.nu Y))
            (KIP126.Kervaire.Route.finiteExtensionMap KIP126.AdamsSynthetic.Standard.model X Y f (rLater - 1))
            (KIP126.Kervaire.Route.finiteExtensionMap KIP126.AdamsSynthetic.Standard.model X Y f (rEarlier - 1)) ra rb
            ((KIP126.AdamsSynthetic.Standard.model.quotients.natural
                  (KIP126.AdamsSynthetic.Standard.model.normalizedMap X Y f).map).rho_naturality
              (Nat.sub_le_sub_right hle 1))
            (t - s,
              t + ↑(KIP126.AdamsSynthetic.normalizedExponent KIP126.AdamsSynthetic.Standard.model.classicalTower f))
            s n W.source W.target W.equation }
'KIP126.ProofTools.Paper.finiteExtension_descends' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]

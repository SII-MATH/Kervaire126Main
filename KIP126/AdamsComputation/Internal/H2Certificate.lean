private theorem h2SubpermZero {α R : Type*} [CommMonoidWithZero R]
    (f : α → R) (a b : List α) (h : a.Subperm b) (hz : (a.map f).prod = 0) :
    (b.map f).prod = 0 := by
  obtain ⟨l,hp,hs⟩ := h
  have hd := (hs.map f).prod_dvd_prod
  rw [(hp.map f).prod_eq, hz] at hd
  exact zero_dvd_iff.mp hd
private theorem h2EnumeratedZero (w : List (Fin archiveGeneratorCount))
    (hw : w ∈ enumerateMonomials archiveGeneratorDegree h2Candidates 13 0 13 135) :
    h2X ⟨2,by decide⟩ * (w.map h2X).prod = 0 := by
  have hg := List.all_eq_true.mp h2EnumerationChecked w hw
  simp only [h2WordGood,Bool.or_eq_true,List.any_eq_true,decide_eq_true_eq,List.contains_iff_mem] at hg
  rcases hg with ⟨f,hf,hsub⟩ | hex
  · have h := h2SubpermZero h2X f (⟨2,by decide⟩ :: w) hsub (h2FactorsZero f hf)
    exact h
  · exact h2ExceptionsZero w hex

private theorem h2MonomialZero (m : Fin archiveGeneratorCount →₀ ℕ)
    (hm : Finsupp.weight archiveGeneratorDegree m = (13,135)) :
    nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.X ⟨2,by decide⟩) *
      nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.monomial m 1) = 0 := by
  have hfst : Finsupp.weight (fun i => (archiveGeneratorDegree i).1) m = 13 := by
    simpa only [Finsupp.weight_apply,Finsupp.sum,Prod.fst_sum,Prod.smul_fst] using congrArg Prod.fst hm
  have hsnd : Finsupp.weight (fun i => (archiveGeneratorDegree i).2) m = 135 := by
    simpa only [Finsupp.weight_apply,Finsupp.sum,Prod.snd_sum,Prod.smul_snd] using congrArg Prod.snd hm
  have hind : ∀ i ∈ m.support, i ∈ h2Candidates ∧ 0 ≤ i.val := by
    intro i hi
    have h1 := Finsupp.le_weight_of_ne_zero' (fun i => (archiveGeneratorDegree i).1) (Finsupp.mem_support_iff.mp hi)
    have h2 := Finsupp.le_weight_of_ne_zero' (fun i => (archiveGeneratorDegree i).2) (Finsupp.mem_support_iff.mp hi)
    rw [hfst] at h1
    rw [hsnd] at h2
    exact ⟨h2Candidates_complete i h1 h2,Nat.zero_le _⟩
  obtain ⟨w,hw,heq⟩ := enumerateMonomials_complete archiveGeneratorDegree h2Candidates thetaCandidates_positive 13 0 13 135 m hm (by decide) hind
  rw [←heq,thetaProjectedWord]
  exact h2EnumeratedZero w hw
private theorem h2RawZero
    (x : ↥(nativePart archiveGeneratorCount archiveGeneratorDegree archiveSourceRelations 13 135)) :
    nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.X ⟨2,by decide⟩) * x.val = 0 := by
  obtain ⟨p,hp,hx⟩ := x.property
  change p.IsWeightedHomogeneous archiveGeneratorDegree (13,135) at hp
  change nativeProjection archiveGeneratorCount archiveSourceRelations p = x.val at hx
  rw [←hx]
  clear hx x
  induction hp using MvPolynomial.IsWeightedHomogeneous.induction_on with
  | zero => simp
  | add p q hp hq ihp ihq => simp only [map_add,mul_add,ihp,ihq,add_zero]
  | monomial m r hm =>
    have hr : MvPolynomial.monomial m r = MvPolynomial.C r * MvPolynomial.monomial m 1 := by rw [MvPolynomial.C_mul_monomial,mul_one]
    rw [hr,map_mul]
    calc
      _ = nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.C r) *
        (nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.X ⟨2,by decide⟩) *
          nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.monomial m 1)) := by ring
      _ = 0 := by rw [h2MonomialZero m hm,mul_zero]


  change basis .sphere 9 71 0=product (r := (9,71))
    (product (r := (7,7))
      (product (r := (6,6)) (product (r := (5,5)) (product (r := (4,4))
        (product (r := (3,3)) (product (r := (2,2)) h0 h0) h0) h0) h0) h0) h0)
    h5Square at hv
  rw [←h0SixAssembly_left_value] at hv

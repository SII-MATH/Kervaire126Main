private theorem thetaSourceZero_of_monomials
    (hmono : ∀ (m : Fin generators.count →₀ ℕ),
      Finsupp.weight generators.degree m = (7, 70) →
      nativeProjection generators.count archiveSourceRelations (MvPolynomial.X ⟨18, by decide⟩) *
        nativeProjection generators.count archiveSourceRelations (MvPolynomial.monomial m 1) = 0)
    (x : sourceData.component 7 70) :
    sourceData.product 1 32 7 70 (sourceData.atom .h5) x = 0 := by
  apply Subtype.ext
  change nativeProjection generators.count archiveSourceRelations (MvPolynomial.X ⟨18, by decide⟩) * x.val = 0
  obtain ⟨p, hp, hx⟩ := x.property
  change p.IsWeightedHomogeneous generators.degree (7, 70) at hp
  change nativeProjection generators.count archiveSourceRelations p = x.val at hx
  rw [← hx]
  clear hx x
  induction hp using MvPolynomial.IsWeightedHomogeneous.induction_on with
  | zero => simp
  | add p q hp hq ihp ihq => simp only [map_add, mul_add, ihp, ihq, add_zero]
  | monomial m r hm =>
      have hmr : MvPolynomial.monomial m r = MvPolynomial.C r * MvPolynomial.monomial m 1 := by rw [MvPolynomial.C_mul_monomial, mul_one]
      rw [hmr, map_mul]
      calc
        _ = nativeProjection generators.count archiveSourceRelations (MvPolynomial.C r) *
            (nativeProjection generators.count archiveSourceRelations (MvPolynomial.X ⟨18, by decide⟩) *
            nativeProjection generators.count archiveSourceRelations (MvPolynomial.monomial m 1)) := by ring
        _ = 0 := by rw [hmono m hm, mul_zero]

private theorem thetaSourceZero_from_enumerated
    (henum : ∀ w ∈ thetaMonomials,
      thetaX ⟨18,by decide⟩ * (w.map thetaX).prod = 0)
    (x : sourceData.component 7 70) :
    sourceData.product 1 32 7 70 (sourceData.atom .h5) x = 0 := by
  apply thetaSourceZero_of_monomials ?_ x
  intro m hm
  have hindices : ∀ i ∈ m.support, i ∈ thetaCandidates ∧ 0 ≤ i.val := by
    intro i hi
    have hws : Finsupp.weight (fun i => (generators.degree i).1) m = 7 := by
      simpa only [Finsupp.weight_apply, Finsupp.sum, Prod.fst_sum, Prod.smul_fst] using congrArg Prod.fst hm
    have hwt : Finsupp.weight (fun i => (generators.degree i).2) m = 70 := by
      simpa only [Finsupp.weight_apply, Finsupp.sum, Prod.snd_sum, Prod.smul_snd] using congrArg Prod.snd hm
    have hls := Finsupp.le_weight_of_ne_zero' (fun i => (generators.degree i).1) (Finsupp.mem_support_iff.mp hi)
    have hlt := Finsupp.le_weight_of_ne_zero' (fun i => (generators.degree i).2) (Finsupp.mem_support_iff.mp hi)
    rw [hws] at hls
    rw [hwt] at hlt
    exact ⟨thetaCandidates_complete i hls hlt, Nat.zero_le _⟩
  obtain ⟨w, hw, hwm⟩ := enumerateMonomials_complete generators.degree thetaCandidates
    thetaCandidates_positive 7 0 7 70 m hm (by decide) hindices
  rw [thetaEnumeration] at hw
  rw [← hwm, thetaProjectedWord]
  exact henum w hw
private theorem thetaSourceZero (x : sourceData.component 7 70) :
    sourceData.product 1 32 7 70 (sourceData.atom .h5) x = 0 :=
  thetaSourceZero_from_enumerated thetaEnumeratedZero x


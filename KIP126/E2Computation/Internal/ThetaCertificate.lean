private theorem thetaRawZero_of_monomials
    (hmono : ∀ (m : Fin archiveGeneratorCount →₀ ℕ),
      Finsupp.weight archiveGeneratorDegree m = (7, 70) →
      nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.X ⟨18, by decide⟩) *
        nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.monomial m 1) = 0)
    (x : nativePart archiveGeneratorCount archiveGeneratorDegree archiveSourceRelations 7 70) :
    nativeProjection archiveGeneratorCount archiveSourceRelations
      (MvPolynomial.X ⟨18, by decide⟩) * x.val = 0 := by
  obtain ⟨p, hp, hx⟩ := x.property
  change p.IsWeightedHomogeneous archiveGeneratorDegree (7, 70) at hp
  change nativeProjection archiveGeneratorCount archiveSourceRelations p = x.val at hx
  rw [← hx]
  clear hx x
  induction hp using MvPolynomial.IsWeightedHomogeneous.induction_on with
  | zero => simp
  | add p q hp hq ihp ihq => simp only [map_add, mul_add, ihp, ihq, add_zero]
  | monomial m r hm =>
      have hmr : MvPolynomial.monomial m r = MvPolynomial.C r * MvPolynomial.monomial m 1 := by rw [MvPolynomial.C_mul_monomial, mul_one]
      rw [hmr, map_mul]
      calc
        _ = nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.C r) *
            (nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.X ⟨18, by decide⟩) *
            nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.monomial m 1)) := by ring
        _ = 0 := by rw [hmono m hm, mul_zero]

private theorem thetaRawZero_from_enumerated
    (henum : ∀ w ∈ thetaMonomials,
      thetaX ⟨18,by decide⟩ * (w.map thetaX).prod = 0)
    (x : nativePart archiveGeneratorCount archiveGeneratorDegree archiveSourceRelations 7 70) :
    nativeProjection archiveGeneratorCount archiveSourceRelations
      (MvPolynomial.X ⟨18, by decide⟩) * x.val = 0 := by
  apply thetaRawZero_of_monomials ?_ x
  intro m hm
  have hindices : ∀ i ∈ m.support, i ∈ thetaCandidates ∧ 0 ≤ i.val := by
    intro i hi
    have hws : Finsupp.weight (fun i => (archiveGeneratorDegree i).1) m = 7 := by
      simpa only [Finsupp.weight_apply, Finsupp.sum, Prod.fst_sum, Prod.smul_fst] using congrArg Prod.fst hm
    have hwt : Finsupp.weight (fun i => (archiveGeneratorDegree i).2) m = 70 := by
      simpa only [Finsupp.weight_apply, Finsupp.sum, Prod.snd_sum, Prod.smul_snd] using congrArg Prod.snd hm
    have hls := Finsupp.le_weight_of_ne_zero' (fun i => (archiveGeneratorDegree i).1) (Finsupp.mem_support_iff.mp hi)
    have hlt := Finsupp.le_weight_of_ne_zero' (fun i => (archiveGeneratorDegree i).2) (Finsupp.mem_support_iff.mp hi)
    rw [hws] at hls
    rw [hwt] at hlt
    exact ⟨thetaCandidates_complete i hls hlt, Nat.zero_le _⟩
  obtain ⟨w, hw, hwm⟩ := enumerateMonomials_complete archiveGeneratorDegree thetaCandidates
    thetaCandidates_positive 7 0 7 70 m hm (by decide) hindices
  rw [thetaEnumeration] at hw
  rw [← hwm, thetaProjectedWord]
  exact henum w hw
private theorem thetaRawZero
    (x : nativePart archiveGeneratorCount archiveGeneratorDegree archiveSourceRelations 7 70) :
    nativeProjection archiveGeneratorCount archiveSourceRelations
      (MvPolynomial.X ⟨18, by decide⟩) * x.val = 0 :=
  thetaRawZero_from_enumerated thetaEnumeratedZero x


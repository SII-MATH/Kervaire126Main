private theorem namedRelationH5Zero : (nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.X ⟨18,by decide⟩))^1 * (nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.X ⟨82,by decide⟩))^1 = 0 := by
  have h18 : 18 < archiveGeneratorCount := by decide
  have h82 : 82 < archiveGeneratorCount := by decide
  have hr := namedRelationProjectionZero archiveGeneratorCount archiveSourceRelations "18,1,82,1" namedRelationH5Member
  have hs : "18,1,82,1".splitOn ";"=["18,1,82,1"] := by
    simp +decide [String.splitOn,String.splitOnAux]
  have hp00 : "18,1,82,1"≠"" := by decide
  have hp0 : (("18,1,82,1".splitOn ",").map (fun n => n.toNat?.getD 0))=[18, 1, 82, 1] := by
    have hs : "18,1,82,1".splitOn ","=["18","1","82","1"] := by
      simp +decide [String.splitOn,String.splitOnAux]
    rw [hs]
    simp +decide [String.toNat?,String.Slice.toNat?,String.Slice.isNat,
      String.Slice.forIn_eq_forIn_toList,String.Slice.foldl_eq_foldl_toList]
  simp only [nativeRelationPolynomial,hs,List.map_cons,List.map_nil,List.sum_cons,
    List.sum_nil,add_zero,nativeMonomialOfString,if_neg hp00,hp0,nativePolynomialOfPowers,
    dif_pos h18,dif_pos h82,map_mul,map_pow,map_one,mul_one,pow_one] at hr
  simpa only [pow_one] using hr


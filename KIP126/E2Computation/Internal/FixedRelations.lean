private def namedProjectionX (i : Fin archiveGeneratorCount) :
    nativeAlgebra archiveGeneratorCount archiveSourceRelations :=
  nativeProjection archiveGeneratorCount archiveSourceRelations (MvPolynomial.X i)

private theorem namedCorrectionRelation0 : (namedProjectionX ⟨0,by decide⟩) * (namedProjectionX ⟨1,by decide⟩) = 0 := by
  have h0 : 0 < archiveGeneratorCount := by decide
  have h1 : 1 < archiveGeneratorCount := by decide
  have hr := namedRelationProjectionZero archiveGeneratorCount archiveSourceRelations "0,1,1,1" namedRelationH0H1Member
  have hs : "0,1,1,1".splitOn ";" = ["0,1,1,1"] := by
    simp +decide [String.splitOn,String.splitOnAux]
  have hp0 : "0,1,1,1" ≠ "" := by decide
  have hn0 : (("0,1,1,1".splitOn ",").map (fun n=>n.toNat?.getD 0)) = [0, 1, 1, 1] := by
    have hs : "0,1,1,1".splitOn "," = ["0", "1", "1", "1"] := by
      simp +decide [String.splitOn,String.splitOnAux]
    rw [hs]
    simp +decide [String.toNat?,String.Slice.toNat?,String.Slice.isNat,
      String.Slice.forIn_eq_forIn_toList,String.Slice.foldl_eq_foldl_toList]
  simp only [nativeRelationPolynomial,hs,List.map_cons,List.map_nil,List.sum_cons,List.sum_nil,add_zero,
    nativeMonomialOfString,if_neg hp0,hn0,nativePolynomialOfPowers,
    dif_pos h0,dif_pos h1,map_add,map_mul,map_pow,map_one,mul_one,pow_one] at hr
  simpa only [namedProjectionX,mul_assoc,add_assoc] using hr

